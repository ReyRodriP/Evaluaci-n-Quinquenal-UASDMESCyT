# =============================================================================
# EVALUACION QUINQUENAL UASD-MESCyT - Configuracion de DESARROLLO local (Docker)
# -----------------------------------------------------------------------------
# setup-todo.ps1 copia este archivo a .env automaticamente si .env no existe y
# luego genera claves aleatorias para SECRET_KEY, DB_PASSWORD y REDIS_PASSWORD.
#
# NO usar estos valores en produccion: son publicos y estan en git.
# Para produccion, copia .env.example a .env y completa cada valor.
# =============================================================================

# -----------------------------------------------------------------------------
# Imagenes: el stack se construye localmente (docker compose build), asi que
# no hay nada que configurar aqui. Si algun dia se publican imagenes en GHCR,
# se anade `image:` al servicio en docker-compose.yml y el pull las baja solo.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Django
# DEBUG=True muestra tracebacks utiles en desarrollo y sirve los estaticos
# del admin. En produccion debe ser False.
# -----------------------------------------------------------------------------
DEBUG=True
# Placeholder de desarrollo. setup-todo.ps1 lo sustituye por una clave aleatoria
# de 50 caracteres al crear el .env.
SECRET_KEY=dev-only-secret-key-cambiado-por-setup-todo-ps1-al-copiar
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost

# -----------------------------------------------------------------------------
# PostgreSQL (contenedor `db`)
# -----------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=evaluacion_quinquenal
DB_USER=evaluacion_user
DB_PASSWORD=dev_db_password
DB_HOST=db
DB_PORT=5432

# -----------------------------------------------------------------------------
# Redis (cache y limites de peticiones)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=dev_redis_password
REDIS_URL=redis://:dev_redis_password@redis:6379/1

# -----------------------------------------------------------------------------
# Email: en desarrollo se imprime en los logs del contenedor, sin SMTP
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@localhost
NOTIFICACIONES_EMAIL_ENABLED=False

# -----------------------------------------------------------------------------
# Sentry (monitoreo de errores) - vacio en desarrollo
# -----------------------------------------------------------------------------
SENTRY_DSN=

# -----------------------------------------------------------------------------
# CORS: solo los origenes del stack local (Angular dev server en 4200)
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:4200

# -----------------------------------------------------------------------------
# Seguridad / HTTPS: desactivado porque el stack local sirve HTTP plano.
# En produccion con certificado SSL: True / True / 31536000 / True / True
# -----------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# -----------------------------------------------------------------------------
# Superusuario de desarrollo (la crea setup-todo.ps1 y carga datos con `seed`).
# Cambia la contrasena en tu .env local; no la subas a git.
# -----------------------------------------------------------------------------
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@uased.local
SUPERUSER_PASSWORD=AdminDev2026
