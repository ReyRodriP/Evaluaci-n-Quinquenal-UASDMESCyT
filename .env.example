# =============================================================================
# EVALUACION QUINQUENAL UASD-MESCyT - Variables de Entorno
# =============================================================================

# Django
DEBUG=False
SECRET_KEY=cambiar-esta-clave-en-produccion-minimo-50-caracteres
ALLOWED_HOSTS=tudominio.com,www.tudominio.com
FRONTEND_URL=https://tudominio.com

# PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=evaluacion_quinquenal
DB_USER=evaluacion_user
DB_PASSWORD=cambiar-password-db-en-produccion
DB_HOST=db
DB_PORT=5432

# Redis (opcional - si no se configura usa LocalMemCache)
REDIS_URL=redis://redis:6379/1

# Email (SMTP real)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password-de-gmail
DEFAULT_FROM_EMAIL=noreply@tudominio.com

# Sentry (monitoreo de errores - crear cuenta en sentry.io)
SENTRY_DSN=

# CORS (dominios permitidos)
CORS_ALLOWED_ORIGINS=https://tudominio.com,https://www.tudominio.com

# Seguridad
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
